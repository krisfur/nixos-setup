# Sway configuration. Tiling Wayland compositor; replaces the labwc setup.
# Adapted from the original cachyos-setup sway config, corrected for NixOS and
# carrying the fixes made since (ghostty single-instance, natural scroll, the
# helium wrapper, home-manager-owned theming).

set $mod Mod4
set $terminal ghostty
set $fileManager thunar
set $menu fuzzel
set $browser helium
set $lockcmd ~/.config/sway/lock.sh

output * scale 1

font pango:JetBrainsMono Nerd Font 10
floating_modifier $mod normal

# Session bring-up (keyring adoption, dbus env push, graphical-session.target,
# swaybg/waybar/tray/polkit/swayidle) runs from one script so the sequencing
# matches what the units expect. Generated by home-manager. swaync is NOT
# launched here: its own user unit starts via graphical-session.target.
exec ~/.config/sway/autostart

# Theming is applied declaratively by home-manager (gtk + dconf), so the old
# `exec_always gsettings ...` lines are gone.

input type:keyboard {
    xkb_layout gb
    xkb_numlock enabled
}

input type:touchpad {
    # Natural (content-follows-finger) scrolling, matching the labwc setup.
    natural_scroll enabled
}

# Cursor theme for the whole seat (replaces the labwc `environment` XCURSOR_*).
seat seat0 xcursor_theme Bibata-Modern-Classic 24

# Whatever the pointer is over takes keyboard focus - the reason for moving off
# labwc, where a colored focus border couldn't land on GTK (ghostty) windows.
focus_follows_mouse yes

gaps inner 4
gaps outer 4
default_border pixel 1
default_floating_border pixel 1

# Focus borders. Order: border bg text indicator child_border.
client.focused          #c67153 #c67153 #1a1a19 #c67153 #c67153
client.focused_inactive #b4512d #b4512d #e1e0da #b4512d #b4512d
client.unfocused        #44423e #44423e #c0c0be #44423e #44423e
client.urgent           #dd6155 #dd6155 #1a1a19 #dd6155 #dd6155

# --- Launchers / window management ---
bindsym $mod+Return exec $terminal
bindsym $mod+w kill
bindsym $mod+m exit
bindsym $mod+Shift+c reload
bindsym $mod+e exec $fileManager
bindsym $mod+t floating toggle
bindsym $mod+space exec $menu
bindsym $mod+f fullscreen toggle
bindsym $mod+b exec $browser
bindsym $mod+l exec $lockcmd

# --- Focus / move ---
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# --- Resize ---
bindsym $mod+Mod1+Right resize grow width 30 px
bindsym $mod+Mod1+Left resize shrink width 30 px
bindsym $mod+Mod1+Down resize grow height 30 px
bindsym $mod+Mod1+Up resize shrink height 30 px

# --- Screenshots (window mode works again under sway's IPC) ---
bindsym Print exec ~/.config/sway/sway-screenshot.sh region
bindsym $mod+Shift+Print exec ~/.config/sway/sway-screenshot.sh output
bindsym $mod+Print exec ~/.config/sway/sway-screenshot.sh window

# --- Workspaces ---
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move the focused window to a workspace *and follow it there*, rather than
# sending it away in the background. `;` chains the two commands in one bind.
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad

# 3-finger swipe to cycle workspaces. The grab-the-window bug that forced this
# off under labwc was labwc-specific; bindgesture is clean in sway.
bindgesture swipe:3:left exec ~/.config/sway/cycle-workspace.sh next
bindgesture swipe:3:right exec ~/.config/sway/cycle-workspace.sh prev

# --- Media / brightness keys ---
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous

# Lock immediately on lid close (swayidle also locks before suspend).
bindswitch --locked lid:on exec $lockcmd

# --- Floating rules for popup-style apps ---
for_window [app_id="^(imv|mpv|org\.pulseaudio\.pavucontrol)$"] floating enable, resize set width 70 ppt height 70 ppt, move position center
for_window [class="^(imv|mpv|org\.pulseaudio\.pavucontrol)$"] floating enable, resize set width 70 ppt height 70 ppt, move position center
# Matched on title, not app_id: --class would change ghostty's GTK application
# id, which is also its single-instance identity, so those launches couldn't
# attach to the running process and paid a ~3.4s cold start instead of ~0.4s.
# ghostty's `title` is fixed by the flag, so the app can't rename the window.
for_window [app_id="^com\.mitchellh\.ghostty$" title="^(btop|bluetuith)$"] floating enable, resize set width 50 ppt height 75 ppt, move position center
