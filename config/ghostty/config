# Ghostty configuration.
# window-width/height are in terminal cells (columns/rows), not pixels.
# The default landed at 79x28, one column short of btop's 80x28 minimum.

font-family = JetBrainsMono Nerd Font
font-size = 11

# Reuse one process across windows: a cold start costs ~3.3s versus ~1.6s, and
# subsequent windows are near-instant. Set here rather than as a CLI flag at
# each launch point, since the default `detect` only enables it for .desktop
# launches. This was previously forced *off* everywhere for a bug that closed
# all windows when one was closed (ghostty-org/ghostty#5868) — that was a
# labwc-era Wayland protocol error and doesn't reproduce on sway. Note
# ghostty-org/ghostty#13083 is still open against 1.3.1: an unserialised
# fontconfig race that can SIGSEGV every window at once with 2+ open. Revert
# to `false` if that starts biting.
gtk-single-instance = true

# Sumi palette: neutral ink-grey ground sampled from the wallpaper, terracotta
# accent. Slots 1-6 stay on their conventional hues; tooling hard-codes them.
palette = 0=#232321
palette = 1=#c4413a
palette = 2=#7f8a6c
palette = 3=#c2a05f
palette = 4=#7f8f9c
palette = 5=#a8808f
palette = 6=#8ba39f
palette = 7=#c0c0be
palette = 8=#5d5d5a
palette = 9=#dd6155
palette = 10=#9aa68c
palette = 11=#cfa961
palette = 12=#9aa9b4
palette = 13=#c09aa8
palette = 14=#a4bbb7
palette = 15=#e1e0da
background = #1a1a19
foreground = #c8c7c3
cursor-color = #c67153
cursor-text = #1a1a19
selection-background = #392c26
selection-foreground = #e1e0da

# Slight translucency for an ephemeral feel. sway has no compositor blur,
# so this is plain alpha over whatever is behind the window.
background-opacity = 0.93

window-width = 110
window-height = 32

# No client-side decorations: sway draws its own pixel border (the focus
# indicator), so ghostty's own CSD edge would just be a redundant surface.
# `none` removes it; ghostty's default `auto` otherwise draws a thin libadwaita
# edge that showed as a stray line in the tiled state.
window-decoration = none
